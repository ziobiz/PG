# 운영 배포 자격증명 템플릿
# 복사:  Setup-Credentials.ps1  또는
#   copy scripts\deploy\credentials.env.example %USERPROFILE%\.pg-deploy\credentials.env
# 실제 비밀번호는 %USERPROFILE%\.pg-deploy\credentials.env 에만 둡니다. Git 커밋 금지.

# SSH (필수)
SSH_HOST=1.234.65.25
SSH_USER=root
SSH_PASSWORD=
# 키 인증 권장 (설정 시 SSH_PASSWORD 불필요)
SSH_KEY_PATH=
SSH_PORT=22

# 원격 pg-app 루트 (restart-pg-app.sh 위치)
REMOTE_PG_APP_DIR=/home/ftpuser/pg-app

# 원격 PostgreSQL (SSH 경유, 보통 localhost)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pgdev
DB_USER=pgadmin
DB_PASSWORD=

# FTP (선택 — 현재 Deploy-Prod는 SSH/SCP 우선. 카페24 정적만 쓸 때 참고)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_SITE=/home/ftpuser/site

# 재시작 후 확인 (선택)
VERIFY_LOG_GREP=Started PgAppApplication
